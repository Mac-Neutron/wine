MODULE = libxess.dll
# XeSS has no 32-bit runtime (Intel ships x64 only), and these follow its 64-bit structures: every 64-bit arch
# (the Mac's ARM64X build is aarch64 and arm64ec), never i386.
ENABLE_ARCHS = aarch64 arm64ec x86_64

VER_FILEDESCRIPTION_STR = "Wine XeSS on MetalFX"
VER_PRODUCTVERSION      = 2,0,1,0
IMPORTS   = dxguid

SOURCES = \
	d3d12.c \
	main.c
